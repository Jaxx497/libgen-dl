{
  "name": "libgen-dl",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "libgen-dl: search and download books from LibGen in the terminal. Fork of libgen-downloader by Ömercan Balandı.",
  "main": "./build/index.js",
  "bin": {
    "libgen-dl": "./build/index.js",
    "lgd": "./build/index.js"
  },
  "homepage": "https://github.com/Jaxx497/libgen-dl",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-cli.mjs",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx,json}' 'test/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx,json}' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' 'test/**/*.ts' --config ./.prettierrc",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,css,md,json}' 'test/**/*.ts' --config ./.prettierrc",
    "clean": "rimraf ./build && rimraf ./standalone-executables",
    "web": "node scripts/build-web.mjs"
  },
  "keywords": [
    "libgen",
    "downloader",
    "tool",
    "cli",
    "parser",
    "output",
    "user-friendly",
    "command",
    "line",
    "library",
    "genesis"
  ],
  "author": "Omercan Balandi<balandiomer@gmail.com>",
  "contributors": [
    "Jaxx497"
  ],
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jaxx497/libgen-dl.git"
  },
  "devDependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@eslint/js": "^9.39.2",
    "@types/content-disposition": "^0.5.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "libgen-dl-storage": "file:plugins/libgen-dl-storage",
    "prettier": "^3.7.4",
    "react-dom": "19.2.3",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "content-disposition": "^1.0.1",
    "figures": "^6.1.0",
    "filesize": "^11.0.13",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "linkedom": "^0.18.12",
    "meow": "^14.0.0",
    "react": "^19.2.3",
    "zustand": "^5.0.9"
  }
}
